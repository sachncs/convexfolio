---
const { title = "Convexfolio documentation", description = "Validated portfolio optimisation in Python." } = Astro.props;
const path = Astro.url.pathname;
const isDocs = path.includes("/docs");
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}assets/favicon.svg`} />
    <title>{title} · Convexfolio</title>
    <link rel="stylesheet" href={`${base}site.css`} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={base} aria-label="Convexfolio home">
        <img src={`${base}assets/logo.svg`} alt="" width="30" height="30" />
        <span>Convexfolio</span>
      </a>
      <nav aria-label="Primary navigation">
        <a class:list={{ active: isDocs }} href={`${base}docs/`}>Documentation</a>
        <a href="https://github.com/sachncs/convexfolio">GitHub</a>
      </nav>
    </header>
    <main class:list={{ docs: isDocs }}>
      <slot />
    </main>
    <footer class="site-footer">
      <span>Convexfolio · research software for constrained portfolio optimisation</span>
      <a href={`${base}docs/faq/`}>FAQ</a>
    </footer>
  </body>
</html>
